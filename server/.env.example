# Copy this file to server/.env and fill in the values. Never commit server/.env.
# Values for existing services: copy them from Render → your service → Environment.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
MONGO_URI=

# ── Auth and encryption ───────────────────────────────────────────────────────
JWT_SECRET=
# Must be the SAME value as on Render, or existing encrypted data can't be read.
ENCRYPTION_KEY=

# ── Twilio (new trial account) ────────────────────────────────────────────────
# LOCAL: leave all three EMPTY. The server then runs in simulation mode (calls and
# SMS are only logged), so your laptop never places real calls or duplicates the
# calls Render makes from the same database.
# RENDER: set them to the new trial account's values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The "From" number shown in Twilio Console → Voice → Try out Voice.
TWILIO_PHONE_NUMBER=

# Public URL that Twilio calls back on: https://<your-service>.onrender.com (no trailing slash).
# Only needed on Render; leave empty locally.
NGROK_URL=
PUBLIC_BASE_URL=

# ── LLM (provider is a setting) ───────────────────────────────────────────────
# groq (free, default for development) or anthropic (optional, final runs and demo)
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Model per tier. Leave empty to use the defaults for the provider:
#   groq:      fast=openai/gpt-oss-20b  smart=openai/gpt-oss-120b  safety=openai/gpt-oss-safeguard-20b
#   anthropic: fast=claude-haiku-5-5    smart=claude-sonnet-5-5    safety=claude-haiku-5-5
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_MODEL_SAFETY=

# ── Email (monthly report) ────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=
